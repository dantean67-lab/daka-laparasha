# Copy this file to ".env.local" ONLY if you need to change a value.
# On Vercel you normally set nothing: the site address is detected automatically.

# Optional. The public address of the site, with no slash at the end.
# Set this only if you later connect a custom domain, for example:
# NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=
